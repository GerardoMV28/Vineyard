# This .gitignore file is configured for Unity projects
# Ignore temporary, cache, build, and user-specific files

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset store-related
[Aa]ssets/AssetStoreTools*

# Visual Studio / VS Code / Rider project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vscode/
.vs/
.idea/

# Unity generated meta files that shouldn't be tracked
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS generated
.DS_Store
Thumbs.db
Desktop.ini
